{
  "name": "gradapp-student",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bundle:auth": "node scripts/bundle-auth.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.js\" \"src/types/**/*.ts\" \"styles/**/*.css\" \"*.html\" \"scripts/**/*.mjs\" \"tests/e2e/**/*.js\" \"*.config.js\" \"*.json\"",
    "format": "prettier --write \"src/**/*.js\" \"src/types/**/*.ts\" \"styles/**/*.css\" \"*.html\" \"scripts/**/*.mjs\" \"tests/e2e/**/*.js\" \"*.config.js\" \"*.json\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:planner": "node --test tests/planner/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
